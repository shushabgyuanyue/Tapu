{
  "name": "tapu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js & vite",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc && vite build",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:terminal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-terminal-encoding.ps1",
    "check:permissions": "node scripts/check-route-permissions.mjs",
    "check:db": "node scripts/check-db-governance.mjs",
    "check:manifests": "node scripts/check-app-manifests.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:server": "node scripts/check-server-syntax.mjs",
    "check:quality": "npm run check:encoding && npm run check:server && npm run check:permissions && npm run check:db && npm run check:manifests && npm run test:contracts && npm run check:size",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.2.0",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  }
}
